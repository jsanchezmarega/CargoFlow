
@if(Shipments.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Origin</th>
                <th>Destination</th>
                <th>Weight</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var shipment in Shipments)
            {
                <tr>
                    <td>@shipment.Id</td>
                    <td>@shipment.CustomerName</td>
                    <td>@shipment.Origin</td>
                    <td>@shipment.Destination</td>
                    <td>@shipment.Weight</td>
                    <td>@shipment.Status</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (shipment.Status == "Planned")
                            {
                                <button class="btn btn-sm btn-primary"
                                        disabled="@(ProcessingShipmentId is not null)"
                                        @onclick="() => OnStartTransit.InvokeAsync(shipment.Id)">
                                    Start Transit
                                </button>
                            }
                            else if (shipment.Status == "InTransit")
                            {
                                <button class="btn btn-sm btn-success"
                                        disabled="@(ProcessingShipmentId is not null)"
                                        @onclick="() => OnDeliver.InvokeAsync(shipment.Id)">
                                    Mark Delivered
                                </button>
                            }

                            @if (shipment.Status is "Planned" or "InTransit")
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@(ProcessingShipmentId is not null)"
                                        @onclick="() => OnCancel.InvokeAsync(shipment.Id)">
                                    Cancel
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
} else
{
    <div>No shipments found.</div>
}


@code {
    [Parameter]
    public IEnumerable<ShipmentResponse> Shipments { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnStartTransit { get; set; }

    [Parameter]
    public EventCallback<int> OnDeliver { get; set; }

    [Parameter]
    public EventCallback<int> OnCancel { get; set; }

    [Parameter]
    public int? ProcessingShipmentId { get; set; }
}
