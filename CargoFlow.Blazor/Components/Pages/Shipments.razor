@page "/shipments"
@rendermode InteractiveServer
@using System.Net
@using CargoFlow.Blazor.Services
@inject ShipmentApiClient ShipmentApi
@inject CustomerApiClient CustomerApi

<PageTitle>Shipments</PageTitle>

<h1>Shipments</h1>

<p>Manage CargoFlow shipments.</p>

<div class="d-flex gap-3 mb-3">
    <div class="mb-3" style="max-width: 220px;">
        <label for="statusFilter" class="form-label">Status</label>
        <select id="statusFilter"
                @bind="selectedStatus"
                @bind:after="ApplyFiltersAsync"
                disabled="@isLoadingShipments"
                class="form-select">
            <option value="">All</option>
            <option value="Planned">Planned</option>
            <option value="InTransit">InTransit</option>
            <option value="Delivered">Delivered</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="mb-3" style="max-width: 220px;">
        <label for="customerFilter" class="form-label">Customer</label>
        <select id="customerFilter"
                @bind="selectedCustomerId"
                @bind:after="ApplyFiltersAsync"
                disabled="@(isLoadingCustomers || isLoadingShipments)"
                class="form-select">
            @if (customers is not null && !isLoadingCustomers)
            {
                <option value="">All</option>
                @foreach (var customer in customers)
                {
                    <option value="@customer.Id">@customer.Name</option>
                }
            }
            else
            {
                <option value="">@(isLoadingCustomers ? "Loading customers..." : "Failed to load customers")</option>
            }
        </select>
        @if (customerErrorMessage is not null)
        {
            <div class="text-danger small">@customerErrorMessage</div>
        }
    </div>

    <div class="mb-3" style="width: 220px;">
        <label for="originFilter" class="form-label">Origin</label>
        <input id="originFilter"
               type="text"
               class="form-control"
               @bind="selectedOrigin"
               @bind:after="ApplyFiltersAsync"
               disabled="@isLoadingShipments"
               placeholder="e.g. Cologne" />
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (actionErrorMessage is not null)
{
    <div class="alert alert-danger">@actionErrorMessage</div>
}

@if (shipments is null)
{
    @if (errorMessage is null)
    {
        <div>Loading shipments...</div>
    }
}
else
{
    <ShipmentTable
        Shipments="@shipments"
        ProcessingShipmentId="@processingShipmentId"
        OnStartTransit="@StartTransitAsync"
        OnDeliver="@SetDeliveredAsync"
        OnCancel="@SetCancelledAsync" />
}

@code {
    private ShipmentResponse[]? shipments;
    private CustomerResponse[]? customers;
    private string? errorMessage;
    private string? customerErrorMessage;
    private string? actionErrorMessage;

    private string selectedStatus = "";
    private int? selectedCustomerId;
    private string selectedOrigin = "";

    private bool isLoadingShipments;
    private bool isLoadingCustomers;
    private int? processingShipmentId;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadShipmentsAsync(),
            LoadCustomersAsync());
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadShipmentsAsync();
    }

    private async Task LoadShipmentsAsync()
    {
        try
        {
            isLoadingShipments = true;
            errorMessage = null;

            shipments = await ShipmentApi.GetShipmentsAsync(
                selectedStatus,
                selectedCustomerId,
                selectedOrigin);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Failed to retrieve shipments: Please try again later.";
        }
        finally
        {
            isLoadingShipments = false;
        }
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            isLoadingCustomers = true;
            customerErrorMessage = null;

            customers = await CustomerApi.GetCustomersAsync();
        }
        catch (HttpRequestException)
        {
            customerErrorMessage = "Failed to retrieve customers: Please try again later.";
        }
        finally
        {
            isLoadingCustomers = false;
        }
    }

    private async Task ChangeStatus(int shipmentId, string action)
    {
        actionErrorMessage = null;
        processingShipmentId = shipmentId;

        try
        {
            var statusCode = await ShipmentApi.ChangeStatusAsync(shipmentId, action);

            if ((int)statusCode >= 200 && (int)statusCode < 300)
            {
                await LoadShipmentsAsync();
            }
            else if (statusCode == HttpStatusCode.Conflict)
            {
                actionErrorMessage =
                    "This shipment cannot perform that action in its current state. Refresh the list and try again.";
            }
            else if (statusCode == HttpStatusCode.NotFound)
            {
                actionErrorMessage = "This shipment no longer exists.";
            }
            else
            {
                actionErrorMessage = action switch
                {
                    "start-transit" => "Failed to start shipment transit.",
                    "deliver" => "Failed to set shipment to delivered.",
                    "cancel" => "Failed to cancel shipment.",
                    _ => "Failed to update shipment."
                };
            }
        }
        catch (HttpRequestException)
        {
            actionErrorMessage = "Failed to update shipment: Please try again later.";
        }
        finally
        {
            processingShipmentId = null;
        }
    }

    private Task StartTransitAsync(int shipmentId)
        => ChangeStatus(shipmentId, "start-transit");

    private Task SetDeliveredAsync(int shipmentId)
        => ChangeStatus(shipmentId, "deliver");

    private Task SetCancelledAsync(int shipmentId)
        => ChangeStatus(shipmentId, "cancel");
}
